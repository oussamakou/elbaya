# The existing Vercel marketplace integration supplies TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN automatically. These SHOP_DATABASE_* alternatives are only
# needed when connecting a database manually.
# Set these in Vercel > Project > Settings > Environment Variables.
# This file intentionally contains no credentials.
SHOP_DATABASE_URL=libsql://YOUR-DATABASE-HOST
SHOP_DATABASE_AUTH_TOKEN=
# Copy the existing values from .env.local to retain the current admin password.
SHOP_ADMIN_PASSWORD_HASH=
SHOP_SESSION_SECRET=
# Optional exact canonical origin, no trailing slash. Use Production scope only;
# previews can leave this unset so same-origin checks use their own domain.
SHOP_ORIGIN=https://farmelbaya.com

# Owner alerts: server-only. Use a verified Resend sender domain.
RESEND_API_KEY=
SHOP_EMAIL_FROM=
SHOP_NOTIFY_EMAIL=
